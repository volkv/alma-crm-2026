# Copy to .env for local development. The values below match docker-compose.yml,
# so `docker compose up -d postgres redis gotenberg mailpit keycloak` + `pnpm dev`
# works as is. Every variable is required: the server refuses to start without
# it. Some are not: BODY_SIZE_LIMIT, which adapter-node reads itself and whose own
# default is too low (see the comment on it below), SEED_DEMO_PASSWORD, which
# belongs to the realm import of Keycloak, EXCHANGE_API_KEY_CMS /
# EXCHANGE_API_KEY_LMS, which belong to the seed of the stand, FONTS_DIR, which
# belongs to the deployment's font volume, and MOCK_CMS_PORT / MOCK_LMS_PORT,
# which belong to the imitators of the stand. The server itself
# never reads those.

NODE_ENV=development

# PostgreSQL (compose publishes 5432 on host port 55432). Локальный стек
# поднимается с паролем `lct`, набранным в `docker-compose.yml`: это умолчание
# для машины разработчика, и только для неё.
#
# На развёртывании эта строка не читается вовсе: `docker-compose.prod.yml`
# собирает `DATABASE_URL` из `POSTGRES_PASSWORD` ниже и передаёт её приложению
# через `environment`, который сильнее `env_file`. Две строки, набранные порознь,
# разъехались бы на первой же смене пароля (docs/deployment.md).
DATABASE_URL=postgres://lct:lct@localhost:55432/lct

# Redis (compose publishes 6379 on host port 56379). То же правило: локально —
# без пароля, на развёртывании `REDIS_URL` собирается из `REDIS_PASSWORD`.
REDIS_URL=redis://localhost:56379

# Пароли СУБД развёртывания. Читает их только Compose — `docker-compose.prod.yml`
# поднимает с ними PostgreSQL (вместе с базой realm каталога) и Redis
# (`--requirepass`) и из них же собирает строки подключения приложения. Без них
# `docker compose up` останавливается и называет переменную; локальному стеку и
# `pnpm dev` они не нужны вовсе.
#
# Значения — свои на каждую установку, буквы и цифры (пароль уезжает в строку
# подключения, и `@` или `/` в нём её сломали бы): `openssl rand -hex 24`. Смена
# пароля PostgreSQL на уже поднятом стенде делается не одной строкой в `.env` —
# порядок в docs/deployment.md, раздел «Пароли СУБД».
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Gotenberg, used to render documents to PDF
GOTENBERG_URL=http://localhost:3001

# Почтовый сервер, через который уходят уведомления о зависших взаимодействиях, и
# обратный адрес письма. В стеке это Mailpit: он ловит всю исходящую почту и
# показывает её на http://localhost:8025 — на стенде это и есть доказательство
# того, что письмо ушло, а не «кажется, отправилось».
#
# Умолчаний у обеих переменных нет: адрес чужого узла и обратный адрес письма
# выбирает развёртывание. Пусто — канал «почта» не отправляет и пишет об этом в
# журнале доставок (/notifications), а не молчит. Настоящая установка ставит сюда
# адрес корпоративного релея (`smtp://relay.example.org:587`, `smtps://…` для
# защищённого соединения; логин и пароль — частью адреса).
# Ловушка — по 127.0.0.1, а не localhost: клиент почты сначала пробует ::1, а
# порт контейнера на Windows открыт только по IPv4, и каждое письмо ждёт 20 с.
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM=lct-crm@example.org

# Настоящая доставка писем людям вне системы — контактным лицам вуза («Отправить
# информацию о программах»). Пусто или `false` — песочница: такие письма уходят
# только на почтовую ловушку (`SMTP_URL` на mailpit, localhost, 127.0.0.1, ::1), а
# на любой другой сервер не уходят вовсе. `true` ставит только установка у
# заказчика вместе с адресом своего релея; на стенде и машине разработчика — никогда.
# Уведомлений сотрудникам флаг не касается.
MAIL_EXTERNAL_DELIVERY=false

# Public origin of the app. Must match how the browser reaches it.
ORIGIN=http://localhost:5173

# Ceiling on the request body. Read by adapter-node in the built server
# (`node build/index.js`); `vite dev` has no such limit. adapter-node defaults to
# 512K, which is below the upload ceiling the code enforces (25 MiB), so an
# ordinary scan would come back 413 without ever reaching the app. Both compose
# files pin the value in `environment`, where it wins over this file; the line
# here is for the built server started outside compose.
BODY_SIZE_LIMIT=27M

# Public demo mode: the sign-in page lists the three demo accounts of the stand
# and the seed fills the database with synthetic data; sessions opened on those
# accounts never get four permissions that would outlive the demonstration
# (docs/auth.md). The compose stack turns it on by default — the local stack is
# the demo stand; here it stays off, because a developer decides for themselves
# whether their machine advertises those accounts.
DEMO_MODE=false

# Take the client address from X-Forwarded-For. Only behind a reverse proxy
# (docs/deployment.md); a directly reachable app keeps it off.
TRUST_PROXY=false

# Shared password of the three demo accounts of the realm. Read — through
# docker-compose.yml — by the realm import of Keycloak, and by nothing else: the
# application has no passwords of its own, and the seed does not set any.
# Значение по умолчанию — то же, что в импорте realm: локальный стек обязан
# подниматься и пускать демонстрационные записи без единой правки. На стенде,
# который видно снаружи, его меняют: этот пароль знает всякий, кто открыл
# репозиторий. Импорт realm отрабатывает один раз, на пустой базе, поэтому
# менять значение надо ДО первого запуска; позже пароль меняют в консоли
# Keycloak (docs/deployment.md).
SEED_DEMO_PASSWORD=lct-demo-2026

# Тот же пароль для карточки на странице входа: приложение паролей не проверяет
# и не хранит, оно только повторяет на экране то, что задано в каталоге, — чтобы
# зритель стенда мог войти, никого не спрашивая. Значение обязано совпадать с
# SEED_DEMO_PASSWORD (а на живом стенде — с тем, на что пароль поменяли в
# консоли Keycloak): иначе карточка покажет пароль, которым не войти. Пусто —
# карточка пароля не называет. Показывается только при DEMO_MODE=true.
DEMO_PASSWORD_HINT=lct-demo-2026

# Exchange with the customer's systems (docs/exchange-contract.md). Four
# directions: an application from the CMS and a snapshot of its status back, a
# request for a learning group and the result of that group. The two addresses
# below are where the CRM goes itself; leave one empty and that direction stays
# off — the CRM will not queue messages nobody will read.
#
# On the stand both point at the imitators from docker-compose.yml, published on
# 58081 and 58082 (inside the compose network they answer on `mock-cms:8081` and
# `mock-lms:8082`, and the compose file already names those). The address of an
# application card carries `{externalId}`: the key of the application goes there.
#
# Whatever is saved on the «Внешние системы» screen wins over these values: they
# are the defaults a deployment comes up with, not the product's settings.
EXCHANGE_CMS_STATUS_URL=http://localhost:58081/api/applications/{externalId}/status
EXCHANGE_LMS_GROUPS_URL=http://localhost:58082/api/groups

# The web service of the learning management system, shown as a hint in the
# integrations section: that is where the synchronisation of learning data goes.
EXCHANGE_LMS_BASE_URL=http://localhost:58082

# Outgoing requests from the server: which hosts on loopback and in private
# networks it may reach on its own. Comma-separated host names (matched exactly),
# addresses and CIDR networks; empty means public addresses only. Everything not
# listed there stays closed: the network around the app holds the account
# directory, the object storage and the cloud metadata service, and the address
# of a webhook receiver is typed in by a person.
# - a developer's machine (this value): the imitators, the webhook receiver and
#   the LMS sit on this machine's loopback;
# - the stand: `mock-cms,mock-lms`;
# - the customer's closed network: the CMS and LMS hosts or their network, for
#   example `cms.corp.local,10.20.0.0/24` — never the loopback.
OUTBOUND_ALLOWED_HOSTS=localhost,127.0.0.0/8,::1/128

# The key the contacts of people (e-mail, phone) are encrypted with before they
# reach the database: AES-256-GCM, a fresh nonce per value, plus a derived key for
# the deterministic comparison hashes the deduplication and the exact-contact
# search run on. 32 bytes, base64 (`openssl rand -base64 32`) or 64 hex characters.
# Required everywhere, including a developer's machine — without it the app cannot
# read a single contact and refuses to start. Losing it is irreversible: nothing
# recovers the contacts of the directory.
# Заполнитель: замените перед развёртыванием.
PII_ENCRYPTION_KEY=pd7xxuL6XwYqagjA3OMN0dZUR+qa4eRzqNQmQnxaPIM=

# The secret the CRM signs its outgoing exchange messages with (HMAC-SHA256, the
# same format as webhooks). The imitators verify the signature against the same
# value and reject an unsigned message, so on the stand the two must match.
# Заполнитель: замените перед развёртыванием.
EXCHANGE_SECRET=exchange-stand-secret-0123456789abcdef

# Names of the connections: the CRM deduplicates messages by system, instance and
# external id, and checks the `source.instance` of an incoming message against
# these. A second site or a second LMS needs a second name.
EXCHANGE_CMS_INSTANCE=itschool-site
EXCHANGE_LMS_INSTANCE=moodle-itschool

# The access keys the imitators introduce themselves with when they send a
# message to the CRM: one per connection, because an exchange key is bound to one
# (`api_keys.exchange_system`) and a shared key would let the site post the
# results of learning groups. The seed of the stand issues both from these
# variables — on a public stand nobody can issue a key through the UI, where the
# demo session has no `api_keys.manage` and the staff administrator has no
# account in the directory yet.
#
# The format is the one the system itself issues and the only one it accepts:
# `lct_` plus 32 characters of base64url (36 in total, 192 bits of randomness).
# Anything else is refused by the seed, loudly — a key of another shape would
# never pass authentication. Generate one with
# `lct_$(openssl rand -base64 24 | tr '+/' '_-' | tr -d '=')`.
#
# Пусто здесь — и это работающее состояние, а не отсутствующая настройка:
# `docker-compose.yml` подставляет на пустое место два демонстрационных ключа
# (`lct_local-dev-only-cms-key-…` и `…-lms-key-…`), разных и заведомо публичных,
# чтобы локальный стек показывал обмен сразу после `docker compose up`. Ключами
# они при этом не являются: их знает всякий, кто открыл репозиторий.
#
# На стенде и в промышленной установке — свои, обязательно. `docker-compose.prod.yml`
# умолчаний не имеет вовсе и требует, чтобы обе переменные были названы в `.env`:
# пусто там значит «ключей обмена нет» (сид скажет это в логе, имитаторы честно
# ответят, что обмен не настроен), а умолчание базового файла туда не доезжает.
#
# Приложение эти значения не читает, а смена значения после первой заливки ключ
# не переписывает: сид предупредит и оставит выпущенный как есть (docs/seeds.md).
EXCHANGE_API_KEY_CMS=
EXCHANGE_API_KEY_LMS=

# Триггер имитатора CMS за кнопкой «Демо: заявка с сайта» на экране «Внешние
# системы»: приложение жмёт его, и сцена обмена начинается там же, где начинается
# у посетителя сайта. Кнопка появляется только при DEMO_MODE=true и только когда
# адрес задан; установка с настоящей CMS оставляет пусто — заявки за посетителя
# она не подаёт. На стенде это `http://mock-cms:8081/__send-application`.
DEMO_CMS_TRIGGER_URL=http://localhost:58081/__send-application

# Токен управления имитаторами: управляющие адреса (`__state`, `__scenario`) и
# собственное тело заявки у триггера сцены. Пусто — управление открыто всякому,
# кто дотянулся до порта имитатора; так он и живёт на машине разработчика, где
# порт этот — петля. Читают его имитаторы, а приложение предъявляет его
# заголовком `X-Mock-Control`, когда демо-переключатель «имитатор недоступен /
# доступен» на экране «Внешние системы» ставит имитатору сценарий отказа
# (только при DEMO_MODE=true).
#
# На развёртывании значение **обязательно и непустое** — и там, где имитаторов
# нет: подстановка Compose идёт по всему файлу сразу, профили её не отменяют, и
# `docker compose up` остановится, назвав переменную. На стенде страница
# состояния и триггер выходят наружу через прокси, и токен — вторая граница
# после него (docs/security.md). Значение своё: `openssl rand -hex 24`.
MOCK_CONTROL_TOKEN=

# Порты, на которых стенд публикует имитаторов на петле хоста
# (`docker-compose.prod.yml`); прокси ходит к ним по этим номерам. В локальном
# стеке имитаторы стоят на 58081 и 58082 и эти переменные не читаются.
MOCK_CMS_PORT=8091
MOCK_LMS_PORT=8092

# Set to true only when a reverse proxy in front of the app sets X-Forwarded-For
# (nginx: `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for`). The app
# then takes the client address from the last entry of that header — the one its
# own proxy appended, everything to the left of it comes from the client — and
# falls back to the socket address when the header is absent, so a request made
# inside the deployment network is answered as usual. Reachable directly means
# false: a client would otherwise pick its own address for the audit log and the
# rate limiter. ADDRESS_HEADER of adapter-node is not used and must stay unset,
# see docs/deployment.md.

# Ключ подсказок Dadata (dadata.ru): по нему раздел поиска организации
# находит реквизиты вуза по названию или ИНН и подставляет их в черновик
# карточки (src/lib/server/enrichment, docs/enrichment.md).
#
# Необязателен. Пусто — поиск выключен и говорит об этом на своей странице, а
# реквизиты заводят руками, как и раньше. Нужен именно ключ подсказок (API
# key) из личного кабинета Dadata: он даёт право только читать справочник.
# Секретный ключ стандартизации сюда не кладут — приложение ею не пользуется.
DADATA_API_KEY=

# Object storage for uploaded and generated documents (MinIO in the compose
# stack; any S3-compatible service works). The values below match
# docker-compose.yml, which publishes the S3 API on host port 59000 and the web
# console on 59001 (http://localhost:59001, same keys).
#
# The bucket is created by the `minio-init` job of the stack, not by the app:
# these keys are only ever used to read and write objects. MinIO ignores the
# region, but a request cannot be signed without one, so it is required here
# too. S3_FORCE_PATH_STYLE=true addresses the bucket by path
# (http://host/bucket/key): a bucket subdomain resolves nowhere in a local
# stack. Ровно `true` или `false`.
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=lct-documents
S3_ACCESS_KEY=lct
S3_SECRET_KEY=lct-secret-key
S3_FORCE_PATH_STYLE=true

# Keycloak: the account directory and the only way into the product — OIDC
# Authorization Code + PKCE, realm `lct`, roles `crm-admin` / `crm-lead` /
# `crm-user` (docs/auth.md; docs/access-matrix.md, section 6). Without the
# directory nobody signs in: the application keeps no passwords.
#
# The compose stack publishes Keycloak on host port 58080; inside the network it
# answers on `keycloak:8080`.

# The administrator of Keycloak itself — realm `master`, console at
# http://localhost:58080/admin. Not an account of the CRM: those live in the realm
# `lct`. Заполнитель: замените перед развёртыванием, на стенде этот пароль
# открывает каталог учётных записей целиком.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Where the server looks for the realm: `<issuer>/.well-known/openid-configuration`
# is the discovery document, and the same string is the `iss` of every token the
# realm issues. With `pnpm dev` the server runs on the host, so this is the
# published port; inside the compose network it is
# `http://keycloak:8080/realms/lct`, and on a stand it is the public address with
# the path, `https://<домен>/auth/realms/lct`.
OIDC_ISSUER_URL=http://localhost:58080/realms/lct

# The public base of every address Keycloak tells about itself: OIDC_ISSUER_URL
# above starts with it, and so does every endpoint in its metadata. It is
# `KC_HOSTNAME` together with the relative path of the installation — on a stand
# `https://<домен>/auth`, locally the published port. No trailing slash.
OIDC_PUBLIC_URL=http://localhost:58080

# Where the SERVER reaches the directory, when that is not the address the
# browser uses. Optional: with `pnpm dev` the server runs on the host and gets
# there by the same published port, so the line stays commented out. Inside the
# compose network it differs — the app and Keycloak stand side by side, and the
# published port is somebody else's address; then metadata, signing keys and the
# code exchange go here while `iss` is still checked against OIDC_ISSUER_URL.
# Docker-compose.yml sets it for the app container itself.
# OIDC_INTERNAL_URL=http://keycloak:8080

# The client of the realm and its secret. The client is confidential: the code is
# exchanged for tokens by the server, with PKCE (S256) on top. The value below is
# the development default baked into `keycloak/realm-lct.json`; a stand passes its
# own — the realm import reads it from the same variable. Заполнитель: замените
# перед развёртыванием.
OIDC_CLIENT_ID=lct-crm
OIDC_CLIENT_SECRET=lct-crm-dev-secret

# Каталог с файлами фирменной гарнитуры Rostelecom Basis. Читает его только
# Compose: `docker-compose.prod.yml` монтирует этот каталог в
# `/app/build/client/fonts`, откуда adapter-node отдаёт его по адресу
# `/fonts/...`. Файлов в репозитории нет — лицензии на распространение у команды
# нет, — поэтому их кладут на машину развёртывания и называют путь здесь; пустой
# или несуществующий каталог ничего не ломает, интерфейс просто идёт на запасной
# гарнитуре (docs/deployment.md, «Шрифт»). Путь абсолютный или относительный
# каталогу с docker-compose.yml. С `pnpm dev` и `pnpm build` переменная не
# участвует вовсе: там шрифт берётся из `static/fonts/`.
FONTS_DIR=./static/fonts
