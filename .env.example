# Copy to .env for local development. The values below match docker-compose.yml,
# so `docker compose up -d postgres redis gotenberg mailpit` + `pnpm dev` works
# as is. Every variable is required: the server refuses to start without it. The
# one exception is BODY_SIZE_LIMIT — adapter-node reads it itself, and its own
# default is too low; see the comment on it below.

NODE_ENV=development

# PostgreSQL (compose publishes 5432 on host port 55432)
DATABASE_URL=postgres://lct:lct@localhost:55432/lct

# Redis (compose publishes 6379 on host port 56379)
REDIS_URL=redis://localhost:56379

# Gotenberg, used to render documents to PDF
GOTENBERG_URL=http://localhost:3001

# Mailpit catches all outgoing mail; its web UI is at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Public origin of the app. Must match how the browser reaches it.
ORIGIN=http://localhost:5173

# Ceiling on the request body. Read by adapter-node in the built server
# (`node build/index.js`); `vite dev` has no such limit. adapter-node defaults to
# 512K, which is below the upload ceiling the code enforces (25 MiB), so an
# ordinary scan would come back 413 without ever reaching the app. Both compose
# files pin the value in `environment`, where it wins over this file; the line
# here is for the built server started outside compose.
BODY_SIZE_LIMIT=27M

# Public demo mode: the demo account may sign in, destructive actions are refused.
# The compose stack turns it on by default — the local stack is the demo stand;
# here it stays off, because a developer decides for themselves whether their
# machine shows the «sign in as …» buttons.
DEMO_MODE=false

# Shared password of the demo accounts created by `pnpm run db:seed`. Read by
# the seed script only, never by the server.
SEED_DEMO_PASSWORD=Demo-Password-2026!

# Set to true only when a reverse proxy in front of the app sets X-Forwarded-For
TRUST_PROXY=false

# Where uploaded and generated files are stored; must be writable and persist
DATA_DIR=./data
