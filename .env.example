# Copy to .env for local development. The values below match docker-compose.yml,
# so `docker compose up -d postgres redis gotenberg mailpit keycloak` + `pnpm dev`
# works as is. Every variable is required: the server refuses to start without
# it. Two are not: BODY_SIZE_LIMIT, which adapter-node reads itself and whose own
# default is too low (see the comment on it below), and SEED_DEMO_PASSWORD, which
# the server never reads at all — it belongs to the realm import of Keycloak.

NODE_ENV=development

# PostgreSQL (compose publishes 5432 on host port 55432)
DATABASE_URL=postgres://lct:lct@localhost:55432/lct

# Redis (compose publishes 6379 on host port 56379)
REDIS_URL=redis://localhost:56379

# Gotenberg, used to render documents to PDF
GOTENBERG_URL=http://localhost:3001

# Mailpit catches all outgoing mail; its web UI is at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Public origin of the app. Must match how the browser reaches it.
ORIGIN=http://localhost:5173

# Ceiling on the request body. Read by adapter-node in the built server
# (`node build/index.js`); `vite dev` has no such limit. adapter-node defaults to
# 512K, which is below the upload ceiling the code enforces (25 MiB), so an
# ordinary scan would come back 413 without ever reaching the app. Both compose
# files pin the value in `environment`, where it wins over this file; the line
# here is for the built server started outside compose.
BODY_SIZE_LIMIT=27M

# Public demo mode: the sign-in page lists the three demo accounts of the stand
# and the seed fills the database with synthetic data; sessions opened on those
# accounts never get four permissions that would outlive the demonstration
# (docs/auth.md). The compose stack turns it on by default — the local stack is
# the demo stand; here it stays off, because a developer decides for themselves
# whether their machine advertises those accounts.
DEMO_MODE=false

# Shared password of the three demo accounts of the realm. Read — through
# docker-compose.yml — by the realm import of Keycloak, and by nothing else: the
# application has no passwords of its own, and the seed does not set any.
# Заполнитель: замените перед развёртыванием — на стенде, который видно снаружи,
# этот пароль знает всякий, кто открыл репозиторий. Импорт realm отрабатывает
# один раз, на пустой базе, поэтому менять значение надо ДО первого запуска;
# позже пароль меняют в консоли Keycloak (docs/deployment.md).
SEED_DEMO_PASSWORD=change-me-before-deploy-Aa1!

# Demonstration stand-in for the learning management system: the routes under
# /mock-lms answer like a Moodle 4.x web service, on invented data. The customer's
# real Moodle is not reachable from outside, so the exchange has nothing to be
# shown against without it. On by default here and in docker-compose.yml, because
# the local stack is the demo stand; a deployment that talks to a real LMS leaves
# it off. Ровно `true` или `false`; переменной нет — заглушки нет.
MOCK_LMS=true

# Set to true only when a reverse proxy in front of the app sets X-Forwarded-For
TRUST_PROXY=false

# Object storage for uploaded and generated documents (MinIO in the compose
# stack; any S3-compatible service works). The values below match
# docker-compose.yml, which publishes the S3 API on host port 59000 and the web
# console on 59001 (http://localhost:59001, same keys).
#
# The bucket is created by the `minio-init` job of the stack, not by the app:
# these keys are only ever used to read and write objects. MinIO ignores the
# region, but a request cannot be signed without one, so it is required here
# too. S3_FORCE_PATH_STYLE=true addresses the bucket by path
# (http://host/bucket/key): a bucket subdomain resolves nowhere in a local
# stack. Ровно `true` или `false`.
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=lct-documents
S3_ACCESS_KEY=lct
S3_SECRET_KEY=lct-secret-key
S3_FORCE_PATH_STYLE=true

# Keycloak: the account directory and the only way into the product — OIDC
# Authorization Code + PKCE, realm `lct`, roles `crm-admin` / `crm-lead` /
# `crm-user` (docs/auth.md; docs/access-matrix.md, section 6). Without the
# directory nobody signs in: the application keeps no passwords.
#
# The compose stack publishes Keycloak on host port 58080; inside the network it
# answers on `keycloak:8080`.

# The administrator of Keycloak itself — realm `master`, console at
# http://localhost:58080/admin. Not an account of the CRM: those live in the realm
# `lct`. Заполнитель: замените перед развёртыванием, на стенде этот пароль
# открывает каталог учётных записей целиком.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Where the server looks for the realm: `<issuer>/.well-known/openid-configuration`
# is the discovery document, and the same string is the `iss` of every token the
# realm issues. With `pnpm dev` the server runs on the host, so this is the
# published port; inside the compose network it is
# `http://keycloak:8080/realms/lct`, and on a stand it is the public address with
# the path, `https://<домен>/auth/realms/lct`.
OIDC_ISSUER_URL=http://localhost:58080/realms/lct

# Where the browser is sent to sign in, when that is not the same address the
# server uses. In the compose stack it differs: the server reaches Keycloak by its
# name inside the network, a person — by the published port. On a stand both are
# the same public address, `https://<домен>/auth`.
OIDC_PUBLIC_URL=http://localhost:58080

# The client of the realm and its secret. The client is confidential: the code is
# exchanged for tokens by the server, with PKCE (S256) on top. The value below is
# the development default baked into `keycloak/realm-lct.json`; a stand passes its
# own — the realm import reads it from the same variable. Заполнитель: замените
# перед развёртыванием.
OIDC_CLIENT_ID=lct-crm
OIDC_CLIENT_SECRET=lct-crm-dev-secret
