# Переменные нагрузочного стенда (`scripts/load/compose.load.yml`).
#
# Файл читается дважды и намеренно: `--env-file` подставляет отсюда значения в
# сами файлы compose (там, где производственное наложение требует их через
# `${VAR:?}`), а `env_file` того же файла отдаёт их приложению. Одно место — это
# чтобы стенд нельзя было собрать из половины одного набора и половины другого.
#
# Секретов здесь нет. Стенд живёт полчаса, стоит на 127.0.0.1, заполнен
# выдуманными данными и после прогона сносится вместе с томами.

NODE_ENV=production

# Своя база и свой Redis в проекте `lct-load`; наружу не публикуются.
DATABASE_URL=postgres://lct:lct@postgres:5432/lct
REDIS_URL=redis://redis:6379
GOTENBERG_URL=http://gotenberg:3000

# Приложение публикуется на петле; этот же адрес становится redirect URI клиента
# в realm при импорте.
ORIGIN=http://localhost:3100

# Демонстрационный набор нужен целиком: нагрузочный опирается на его процесс,
# справочники и учётные записи, а войти на стенд можно только записями realm.
DEMO_MODE=true
SEED_DEMO_PASSWORD=Load-Password-2026!
TRUST_PROXY=false

# Каталог учётных записей этого же проекта, на петле.
OIDC_ISSUER_URL=http://localhost:3180/realms/lct
OIDC_PUBLIC_URL=http://localhost:3180
OIDC_CLIENT_ID=lct-crm
OIDC_CLIENT_SECRET=lct-crm-load-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Хранилище документов этого же проекта.
S3_ACCESS_KEY=lct
S3_SECRET_KEY=lct-load-secret-key

# Почты на нагрузочном стенде нет: Mailpit стоит в профиле `stand` и не
# поднимается, а приложение с пустым `SMTP_URL` уведомления не отправляет.
# Замер про отклик интерфейса, а не про доставку писем.
SMTP_URL=
SMTP_FROM=

# Обмена на нагрузочном стенде нет: имитаторы не поднимаются (профиль `stand`),
# и очередь исходящих не должна накапливать сообщения, которые некому забрать.
EXCHANGE_SECRET=
EXCHANGE_API_KEY_CMS=
EXCHANGE_API_KEY_LMS=
