# Образец переменных нагрузочного стенда (`scripts/load/compose.load.yml`).
#
# Копируется в `scripts/load/load.env` и заполняется на месте — значения
# генерируются командой из `scripts/load/README.md`. Самого `load.env` в
# репозитории нет и быть не может: он несёт ключ шифрования контактов, пароли
# каталога учётных записей и хранилища, и напечатанные в репозитории они не
# защищают ничего (`.gitignore`).
#
# Файл читается дважды и намеренно: `--env-file` подставляет отсюда значения в
# сами файлы compose (там, где производственное наложение требует их через
# `${VAR:?}`), а `env_file` того же файла отдаёт их приложению. Одно место — это
# чтобы стенд нельзя было собрать из половины одного набора и половины другого.
#
# Стенд живёт полчаса, стоит на 127.0.0.1, заполнен выдуманными данными и после
# прогона сносится вместе с томами. Это причина не хранить значения, а не повод
# обходиться без них: пустая строка останавливает `docker compose up`.

NODE_ENV=production

# Пароли своей базы и своего Redis в проекте `lct-load`; наружу не публикуются.
# Строки подключения приложения (`DATABASE_URL`, `REDIS_URL`) собирает из них
# `docker-compose.prod.yml` — здесь их называть не нужно и бесполезно:
# `environment` наложения сильнее `env_file`.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

GOTENBERG_URL=http://gotenberg:3000

# Приложение публикуется на петле; этот же адрес становится redirect URI клиента
# в realm при импорте.
ORIGIN=http://localhost:3100

# Демонстрационный набор нужен целиком: нагрузочный опирается на его процесс,
# справочники и учётные записи, а войти на стенд можно только записями realm.
# Этим же паролем входит сценарий k6 (`run.sh` читает его отсюда).
DEMO_MODE=true
SEED_DEMO_PASSWORD=
TRUST_PROXY=false

# Каталог учётных записей этого же проекта, на петле.
OIDC_ISSUER_URL=http://localhost:3180/realms/lct
OIDC_PUBLIC_URL=http://localhost:3180
OIDC_CLIENT_ID=lct-crm
OIDC_CLIENT_SECRET=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Хранилище документов этого же проекта.
S3_ACCESS_KEY=lct
S3_SECRET_KEY=

# Ключ шифрования контактов людей: без него приложение не поднимается вовсе, а
# нагрузочный набор не заведёт ни одного человека. Генерируется под каждый стенд
# и живёт ровно столько, сколько стенд: после `down -v` том базы уходит вместе с
# шифртекстом, расшифровывать нечего и некому.
PII_ENCRYPTION_KEY=

# Почты на нагрузочном стенде нет: Mailpit стоит в профиле `stand` и не
# поднимается, а приложение с пустым `SMTP_URL` уведомления не отправляет.
# Замер про отклик интерфейса, а не про доставку писем.
SMTP_URL=
SMTP_FROM=

# Обмена на нагрузочном стенде нет: имитаторы не поднимаются (профиль `stand`),
# и очередь исходящих не должна накапливать сообщения, которые некому забрать.
EXCHANGE_SECRET=
EXCHANGE_API_KEY_CMS=
EXCHANGE_API_KEY_LMS=
# Серверу некуда ходить внутри сети: имитаторов нет, узлы CMS и системы
# обучения не названы. Пустое значение — решение «никуда», а не пропуск:
# производственное наложение требует, чтобы переменная была объявлена.
OUTBOUND_ALLOWED_HOSTS=
# Имитаторы стоят в профиле `stand` и не поднимаются, но подстановка переменных
# в Compose идёт по всему файлу сразу, профили её не отменяют: пустой токен
# остановил бы `up` целиком (`${MOCK_CONTROL_TOKEN:?}`). Значение здесь нужно
# только ради этого — управлять на нагрузочном стенде нечем.
MOCK_CONTROL_TOKEN=
