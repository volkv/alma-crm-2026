engine-strict=true

# Выдержка перед установкой свежеопубликованной версии — трое суток в минутах.
# Так проезжают угнанные пакеты: злоумышленник публикует версию под чужим именем,
# и в первые часы её успевают поставить все, кто обновился в этот день. Отзывают
# такую версию обычно в тот же день, поэтому карантин закрывает окно целиком, а
# сборку не тормозит: свои зависимости мы поднимаем не в день выпуска.
# Значение в минутах — так его читает pnpm (`minimumReleaseAge`).
minimum-release-age=4320
