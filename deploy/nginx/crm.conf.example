# Reverse proxy in front of the app container. Copy to
# /etc/nginx/sites-available/<domain>, replace the placeholders, symlink it into
# sites-enabled, then `nginx -t && systemctl reload nginx`.
#
#   CRM_DOMAIN     public host name, e.g. crm.example.com
#   CRM_PORT       loopback port the app publishes — APP_PORT from .env (8099 by default)
#   MOCK_CMS_PORT  loopback port of the CMS imitator — MOCK_CMS_PORT from .env (8091)
#   MOCK_LMS_PORT  loopback port of the LMS imitator — MOCK_LMS_PORT from .env (8092)
#
# The two imitator blocks belong to a demonstration stand (the `stand` profile of
# docker-compose.prod.yml). A deployment that talks to the real CMS and LMS runs
# no imitators and drops both blocks.
#
# Assumes a certificate already covers the domain; point ssl_certificate at
# wherever certbot put it.

# Websocket handshakes need `Connection: upgrade`, plain requests need it
# closed. The variable is prefixed so it cannot collide with a map another
# vhost or a global include may already define.
map $http_upgrade $crm_connection_upgrade {
    default upgrade;
    ''      close;
}

# Cross-origin isolation for what the app serves outside its own hooks: files
# under /_app/immutable and static/ are answered by adapter-node before the
# hooks run and come without these two headers. Every other app response
# already carries them, and a second copy would not be harmless: two values
# join into "same-origin, same-origin", which browsers do not recognise and
# then act as if neither header was sent. So nginx adds each one only when the
# upstream response has none; an empty value makes add_header send nothing.
map $upstream_http_cross_origin_opener_policy $crm_coop {
    ''      same-origin;
    default '';
}

map $upstream_http_cross_origin_resource_policy $crm_corp {
    ''      same-origin;
    default '';
}

server {
    listen 80;
    server_name CRM_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name CRM_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy $crm_coop always;
    add_header Cross-Origin-Resource-Policy $crm_corp always;
    # A demo instance must not end up in search results. Drop this line on a
    # deployment that is meant to be found.
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Upload ceiling, outermost of three. Inside it the app container carries
    # BODY_SIZE_LIMIT=27M (adapter-node) and the code enforces 25 MiB per file.
    # This one must stay the widest: when nginx is the one to refuse, the client
    # gets a bare 413 page instead of the message the form would have shown.
    client_max_body_size 32m;

    access_log /var/log/nginx/crm_access.log;
    error_log  /var/log/nginx/crm_error.log;

    # The imitators of the stand. Exactly two things are open to the outside per
    # imitator: the state page, which is what the audience looks at, and the
    # trigger that starts a scene. Everything else — `__state`, `__scenario` and
    # any address added later — is the control surface of the stand and answers
    # 403 here. The allow-list is matched against the normalised $uri, so an
    # encoded or doubled-up path (`/mock-cms/%5f%5fstate`, `/mock-cms//__state`)
    # fails it too. The imitator itself is the second line: with CONTROL_TOKEN
    # set it refuses those addresses without the X-Mock-Control header
    # (docs/security.md).
    #
    # `if` with nothing but `return` inside is the one form of it that is safe;
    # proxy_pass stays outside it. No add_header lives in these blocks on
    # purpose: nginx drops the inherited ones only where a location declares its
    # own, so the security headers of this server block still apply here.
    location = /mock-cms {
        return 301 /mock-cms/;
    }

    location /mock-cms/ {
        if ($uri !~ "^/mock-cms/(__send-application)?$") {
            return 403;
        }

        proxy_pass http://127.0.0.1:MOCK_CMS_PORT/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /mock-lms {
        return 301 /mock-lms/;
    }

    location /mock-lms/ {
        if ($uri !~ "^/mock-lms/(__send-result)?$") {
            return 403;
        }

        proxy_pass http://127.0.0.1:MOCK_LMS_PORT/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Live interaction card: one server-sent-events stream per open card tab.
    # The app already answers with `X-Accel-Buffering: no`; `proxy_buffering
    # off` says the same here, so a stream is never held back in a buffer even
    # if a middle proxy strips that header. The stream sends a ping comment
    # every 25 s, well inside the 120 s read timeout, so a quiet card is not
    # cut off. Everything else is the same as for the app block below.
    location ~ ^/w/[^/]+/interactions/[0-9a-f-]+/live$ {
        proxy_pass http://127.0.0.1:CRM_PORT;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # MANDATORY for the same reason as in the app block below.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    # The app: everything that is not one of the blocks above. nginx drops
    # inherited add_header directives inside a location that declares its own,
    # so the security headers above would be silently lost for anything served
    # from a block that sets headers of its own.
    location / {
        proxy_pass http://127.0.0.1:CRM_PORT;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $crm_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # MANDATORY. The app runs with TRUST_PROXY=true and takes the client
        # address from the last entry of this header — the one $proxy_add_x_forwarded_for
        # appends here, the address nginx itself accepted the connection from.
        # Without the line the app sees only the socket address, and every
        # visitor lands in the audit log and in the sign-in rate limiter as this
        # proxy: one address for all of them. A proxy configured by hand must
        # carry this line too, or the app has to be started with
        # TRUST_PROXY=false.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;

        # SvelteKit answers with a `Link` header that preloads the modules a page
        # needs; on pages with many of them it runs to 4-5 KB. The default
        # 4k response-header buffer cannot hold that, and nginx turns the whole
        # page into 502 with "upstream sent too big header" in the error log.
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
    }
}
