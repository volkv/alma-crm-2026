{
	"realm": "lct",
	"displayName": "Альма CRM",
	"displayNameHtml": "Альма CRM",
	"loginTheme": "alma",
	"enabled": true,
	"sslRequired": "external",
	"registrationAllowed": false,
	"resetPasswordAllowed": false,
	"rememberMe": false,
	"verifyEmail": false,
	"loginWithEmailAllowed": true,
	"duplicateEmailsAllowed": false,
	"editUsernameAllowed": false,
	"internationalizationEnabled": true,
	"defaultLocale": "ru",
	"supportedLocales": ["ru", "en"],
	"passwordPolicy": "length(12) and notUsername",
	"otpPolicyType": "totp",
	"otpPolicyAlgorithm": "HmacSHA1",
	"otpPolicyDigits": 6,
	"otpPolicyPeriod": 30,
	"otpPolicyLookAheadWindow": 1,
	"otpPolicyCodeReusable": false,
	"bruteForceProtected": true,
	"permanentLockout": false,
	"failureFactor": 30,
	"waitIncrementSeconds": 60,
	"maxFailureWaitSeconds": 60,
	"accessTokenLifespan": 300,
	"ssoSessionIdleTimeout": 1800,
	"ssoSessionMaxLifespan": 28800,
	"offlineSessionIdleTimeout": 28800,
	"roles": {
		"realm": [
			{ "name": "crm-admin", "description": "Администратор системы — наша роль admin" },
			{ "name": "crm-lead", "description": "Руководитель направления — наша роль lead" },
			{ "name": "crm-user", "description": "Менеджер по работе с вузами — наша роль manager" }
		]
	},
	"clients": [
		{
			"clientId": "lct-crm",
			"name": "Альма CRM",
			"description": "Веб-приложение CRM: Authorization Code + PKCE",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": false,
			"secret": "${OIDC_CLIENT_SECRET:lct-crm-dev-secret}",
			"standardFlowEnabled": true,
			"implicitFlowEnabled": false,
			"directAccessGrantsEnabled": false,
			"serviceAccountsEnabled": false,
			"frontchannelLogout": true,
			"fullScopeAllowed": true,
			"redirectUris": [
				"http://localhost:5173/*",
				"http://localhost:4173/*",
				"http://localhost:4174/*",
				"http://localhost:4175/*",
				"http://localhost:4176/*",
				"http://localhost:4177/*",
				"${CRM_ORIGIN:http://localhost:3000}/*"
			],
			"webOrigins": ["+"],
			"attributes": {
				"pkce.code.challenge.method": "S256",
				"post.logout.redirect.uris": "+"
			},
			"protocolMappers": [
				{
					"name": "realm-roles-id-token",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-usermodel-realm-role-mapper",
					"consentRequired": false,
					"config": {
						"multivalued": "true",
						"claim.name": "realm_access.roles",
						"jsonType.label": "String",
						"id.token.claim": "true",
						"access.token.claim": "false",
						"userinfo.token.claim": "true",
						"introspection.token.claim": "true"
					}
				}
			]
		}
	],
	"groups": [
		{
			"name": "demo",
			"path": "/demo",
			"attributes": {
				"otp-exempt": ["true"]
			}
		}
	],
	"browserFlow": "browser-otp",
	"authenticationFlows": [
		{
			"alias": "browser-otp",
			"description": "Вход в браузере: пароль, затем второй фактор по роли",
			"providerId": "basic-flow",
			"topLevel": true,
			"builtIn": false,
			"authenticationExecutions": [
				{
					"authenticator": "auth-cookie",
					"authenticatorFlow": false,
					"requirement": "ALTERNATIVE",
					"priority": 10,
					"userSetupAllowed": false
				},
				{
					"flowAlias": "browser-otp forms",
					"authenticatorFlow": true,
					"requirement": "ALTERNATIVE",
					"priority": 20,
					"userSetupAllowed": false
				}
			]
		},
		{
			"alias": "browser-otp forms",
			"description": "Имя входа и пароль, затем одна из веток второго фактора",
			"providerId": "basic-flow",
			"topLevel": false,
			"builtIn": false,
			"authenticationExecutions": [
				{
					"authenticator": "auth-username-password-form",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 10,
					"userSetupAllowed": false
				},
				{
					"flowAlias": "browser-otp crm-admin",
					"authenticatorFlow": true,
					"requirement": "CONDITIONAL",
					"priority": 20,
					"userSetupAllowed": false
				},
				{
					"flowAlias": "browser-otp crm-lead",
					"authenticatorFlow": true,
					"requirement": "CONDITIONAL",
					"priority": 30,
					"userSetupAllowed": false
				},
				{
					"flowAlias": "browser-otp configured",
					"authenticatorFlow": true,
					"requirement": "CONDITIONAL",
					"priority": 40,
					"userSetupAllowed": false
				}
			]
		},
		{
			"alias": "browser-otp crm-admin",
			"description": "crm-admin вне группы demo: одноразовый код обязателен, не настроен — настройка при входе",
			"providerId": "basic-flow",
			"topLevel": false,
			"builtIn": false,
			"authenticationExecutions": [
				{
					"authenticator": "conditional-user-role",
					"authenticatorConfig": "otp: role crm-admin",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 10,
					"userSetupAllowed": false
				},
				{
					"authenticator": "conditional-user-attribute",
					"authenticatorConfig": "otp: not exempt (crm-admin)",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 20,
					"userSetupAllowed": false
				},
				{
					"authenticator": "auth-otp-form",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 30,
					"userSetupAllowed": false
				}
			]
		},
		{
			"alias": "browser-otp crm-lead",
			"description": "crm-lead без crm-admin вне группы demo: одноразовый код обязателен",
			"providerId": "basic-flow",
			"topLevel": false,
			"builtIn": false,
			"authenticationExecutions": [
				{
					"authenticator": "conditional-user-role",
					"authenticatorConfig": "otp: role crm-lead",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 10,
					"userSetupAllowed": false
				},
				{
					"authenticator": "conditional-user-role",
					"authenticatorConfig": "otp: without crm-admin (crm-lead)",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 20,
					"userSetupAllowed": false
				},
				{
					"authenticator": "conditional-user-attribute",
					"authenticatorConfig": "otp: not exempt (crm-lead)",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 30,
					"userSetupAllowed": false
				},
				{
					"authenticator": "auth-otp-form",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 40,
					"userSetupAllowed": false
				}
			]
		},
		{
			"alias": "browser-otp configured",
			"description": "Остальные вне группы demo: код, если человек настроил его сам",
			"providerId": "basic-flow",
			"topLevel": false,
			"builtIn": false,
			"authenticationExecutions": [
				{
					"authenticator": "conditional-user-configured",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 10,
					"userSetupAllowed": false
				},
				{
					"authenticator": "conditional-user-role",
					"authenticatorConfig": "otp: without crm-admin (configured)",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 20,
					"userSetupAllowed": false
				},
				{
					"authenticator": "conditional-user-role",
					"authenticatorConfig": "otp: without crm-lead (configured)",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 30,
					"userSetupAllowed": false
				},
				{
					"authenticator": "conditional-user-attribute",
					"authenticatorConfig": "otp: not exempt (configured)",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 40,
					"userSetupAllowed": false
				},
				{
					"authenticator": "auth-otp-form",
					"authenticatorFlow": false,
					"requirement": "REQUIRED",
					"priority": 50,
					"userSetupAllowed": false
				}
			]
		}
	],
	"authenticatorConfig": [
		{
			"alias": "otp: role crm-admin",
			"config": {
				"condUserRole": "crm-admin",
				"negate": "false"
			}
		},
		{
			"alias": "otp: not exempt (crm-admin)",
			"config": {
				"attribute_name": "otp-exempt",
				"attribute_expected_value": "true",
				"include_group_attributes": "true",
				"not": "true",
				"regex": "false"
			}
		},
		{
			"alias": "otp: role crm-lead",
			"config": {
				"condUserRole": "crm-lead",
				"negate": "false"
			}
		},
		{
			"alias": "otp: without crm-admin (crm-lead)",
			"config": {
				"condUserRole": "crm-admin",
				"negate": "true"
			}
		},
		{
			"alias": "otp: not exempt (crm-lead)",
			"config": {
				"attribute_name": "otp-exempt",
				"attribute_expected_value": "true",
				"include_group_attributes": "true",
				"not": "true",
				"regex": "false"
			}
		},
		{
			"alias": "otp: without crm-admin (configured)",
			"config": {
				"condUserRole": "crm-admin",
				"negate": "true"
			}
		},
		{
			"alias": "otp: without crm-lead (configured)",
			"config": {
				"condUserRole": "crm-lead",
				"negate": "true"
			}
		},
		{
			"alias": "otp: not exempt (configured)",
			"config": {
				"attribute_name": "otp-exempt",
				"attribute_expected_value": "true",
				"include_group_attributes": "true",
				"not": "true",
				"regex": "false"
			}
		}
	]
}
