{
	"realm": "lct",
	"displayName": "ЛЦТ CRM",
	"enabled": true,
	"sslRequired": "external",
	"registrationAllowed": false,
	"resetPasswordAllowed": false,
	"rememberMe": false,
	"verifyEmail": false,
	"loginWithEmailAllowed": true,
	"duplicateEmailsAllowed": false,
	"editUsernameAllowed": false,
	"internationalizationEnabled": true,
	"defaultLocale": "ru",
	"supportedLocales": ["ru", "en"],
	"passwordPolicy": "length(12) and notUsername",
	"bruteForceProtected": true,
	"permanentLockout": false,
	"failureFactor": 10,
	"waitIncrementSeconds": 60,
	"maxFailureWaitSeconds": 900,
	"accessTokenLifespan": 300,
	"ssoSessionIdleTimeout": 1800,
	"ssoSessionMaxLifespan": 28800,
	"offlineSessionIdleTimeout": 28800,
	"roles": {
		"realm": [
			{ "name": "crm-admin", "description": "Администратор системы — наша роль admin" },
			{ "name": "crm-lead", "description": "Руководитель направления — наша роль lead" },
			{ "name": "crm-user", "description": "Менеджер по работе с вузами — наша роль manager" }
		]
	},
	"clients": [
		{
			"clientId": "lct-crm",
			"name": "ЛЦТ CRM",
			"description": "Веб-приложение CRM: Authorization Code + PKCE",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": false,
			"secret": "${OIDC_CLIENT_SECRET:lct-crm-dev-secret}",
			"standardFlowEnabled": true,
			"implicitFlowEnabled": false,
			"directAccessGrantsEnabled": false,
			"serviceAccountsEnabled": false,
			"frontchannelLogout": true,
			"fullScopeAllowed": true,
			"redirectUris": [
				"http://localhost:5173/*",
				"http://localhost:4173/*",
				"${CRM_ORIGIN:http://localhost:3000}/*"
			],
			"webOrigins": ["+"],
			"attributes": {
				"pkce.code.challenge.method": "S256",
				"post.logout.redirect.uris": "+"
			},
			"protocolMappers": [
				{
					"name": "realm-roles-id-token",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-usermodel-realm-role-mapper",
					"consentRequired": false,
					"config": {
						"multivalued": "true",
						"claim.name": "realm_access.roles",
						"jsonType.label": "String",
						"id.token.claim": "true",
						"access.token.claim": "false",
						"userinfo.token.claim": "true",
						"introspection.token.claim": "true"
					}
				}
			]
		}
	],
	"users": [
		{
			"username": "admin",
			"email": "admin@demo.lct-crm.local",
			"firstName": "Администратор",
			"lastName": "Демо",
			"enabled": true,
			"emailVerified": true,
			"requiredActions": [],
			"credentials": [
				{
					"type": "password",
					"temporary": false,
					"value": "${KEYCLOAK_DEMO_PASSWORD:Demo-Password-2026!}"
				}
			],
			"realmRoles": ["crm-admin"]
		},
		{
			"username": "lead",
			"email": "lead@demo.lct-crm.local",
			"firstName": "Руководитель",
			"lastName": "Демо",
			"enabled": true,
			"emailVerified": true,
			"requiredActions": [],
			"credentials": [
				{
					"type": "password",
					"temporary": false,
					"value": "${KEYCLOAK_DEMO_PASSWORD:Demo-Password-2026!}"
				}
			],
			"realmRoles": ["crm-lead"]
		},
		{
			"username": "manager",
			"email": "manager@demo.lct-crm.local",
			"firstName": "Менеджер",
			"lastName": "Демо",
			"enabled": true,
			"emailVerified": true,
			"requiredActions": [],
			"credentials": [
				{
					"type": "password",
					"temporary": false,
					"value": "${KEYCLOAK_DEMO_PASSWORD:Demo-Password-2026!}"
				}
			],
			"realmRoles": ["crm-user"]
		}
	]
}
